    sha256msg2  xmm3, xmm6
    pshufd      xmm0, xmm0, $0E
    sha256rnds2 xmm1, xmm2, xmm0
    sha256msg1  xmm5, xmm6
    // rounds 48..51
    movdqa      xmm0, xmm3
    paddd       xmm0, [r9 + 208]
    sha256rnds2 xmm2, xmm1, xmm0
    movdqa      xmm7, xmm3
    palignr     xmm7, xmm6, 4
    paddd       xmm4, xmm7
    sha256msg2  xmm4, xmm3
    pshufd      xmm0, xmm0, $0E
    sha256rnds2 xmm1, xmm2, xmm0
    sha256msg1  xmm6, xmm3
    // rounds 52..55
    movdqa      xmm0, xmm4
    paddd       xmm0, [r9 + 224]
    sha256rnds2 xmm2, xmm1, xmm0
    movdqa      xmm7, xmm4
    palignr     xmm7, xmm3, 4
    paddd       xmm5, xmm7
    sha256msg2  xmm5, xmm4
    pshufd      xmm0, xmm0, $0E
    sha256rnds2 xmm1, xmm2, xmm0
    // rounds 56..59
    movdqa      xmm0, xmm5
    paddd       xmm0, [r9 + 240]
    sha256rnds2 xmm2, xmm1, xmm0
    movdqa      xmm7, xmm5
    palignr     xmm7, xmm4, 4
    paddd       xmm6, xmm7
    sha256msg2  xmm6, xmm5
    pshufd      xmm0, xmm0, $0E
    sha256rnds2 xmm1, xmm2, xmm0
    // rounds 60..63
    movdqa      xmm0, xmm6
    paddd       xmm0, [r9 + 256]
    sha256rnds2 xmm2, xmm1, xmm0
    pshufd      xmm0, xmm0, $0E
    sha256rnds2 xmm1, xmm2, xmm0
    movdqu      xmm3, [rax]
    paddd       xmm1, xmm3
    movdqu      xmm3, [rax + 16]
    paddd       xmm2, xmm3
    add   rdx, 64
    cmp   rdx, r8
    jb    @loop
    pshufd      xmm1, xmm1, $1B
    pshufd      xmm2, xmm2, $B1
    movdqa      xmm7, xmm1
    pblendw     xmm1, xmm2, $F0
    palignr     xmm2, xmm7, 8
    movdqu      [rcx], xmm1
    movdqu      [rcx + 16], xmm2
@done:
end;
