procedure SHA256CompressSHANI(State: Pointer; Data: PByte; Blocks: NativeUInt);
var
  Save: array[0..31] of Byte;
asm
    // rcx = State, rdx = Data, r8 = Blocks
    .SAVENV xmm6
    .SAVENV xmm7
    test  r8, r8
    jz    @done
    shl   r8, 6
    add   r8, rdx
    mov   r9, [SHA256Consts]
    lea   rax, Save
    movdqu      xmm1, [rcx]
    movdqu      xmm2, [rcx + 16]
    pshufd      xmm1, xmm1, $B1
    pshufd      xmm2, xmm2, $1B
    movdqa      xmm7, xmm1
    palignr     xmm1, xmm2, 8
    pblendw     xmm2, xmm7, $F0
@loop:
    movdqu      [rax], xmm1
    movdqu      [rax + 16], xmm2
    // rounds 0..3
    movdqu      xmm0, [rdx + 0]
    pshufb      xmm0, [r9]
    movdqa      xmm3, xmm0
    paddd       xmm0, [r9 + 16]
    sha256rnds2 xmm2, xmm1, xmm0
    pshufd      xmm0, xmm0, $0E
    sha256rnds2 xmm1, xmm2, xmm0
    // rounds 4..7
    movdqu      xmm0, [rdx + 16]
    pshufb      xmm0, [r9]
    movdqa      xmm4, xmm0
    paddd       xmm0, [r9 + 32]
    sha256rnds2 xmm2, xmm1, xmm0
    pshufd      xmm0, xmm0, $0E
    sha256rnds2 xmm1, xmm2, xmm0
    sha256msg1  xmm3, xmm4
    // rounds 8..11
    movdqu      xmm0, [rdx + 32]
    pshufb      xmm0, [r9]
    movdqa      xmm5, xmm0
    paddd       xmm0, [r9 + 48]
    sha256rnds2 xmm2, xmm1, xmm0
    pshufd      xmm0, xmm0, $0E
    sha256rnds2 xmm1, xmm2, xmm0
    sha256msg1  xmm4, xmm5
    // rounds 12..15
    movdqu      xmm0, [rdx + 48]
    pshufb      xmm0, [r9]
    movdqa      xmm6, xmm0
    paddd       xmm0, [r9 + 64]
    sha256rnds2 xmm2, xmm1, xmm0
    movdqa      xmm7, xmm6
    palignr     xmm7, xmm5, 4
    paddd       xmm3, xmm7
    sha256msg2  xmm3, xmm6
    pshufd      xmm0, xmm0, $0E
    sha256rnds2 xmm1, xmm2, xmm0
    sha256msg1  xmm5, xmm6
    // rounds 16..19
    movdqa      xmm0, xmm3
    paddd       xmm0, [r9 + 80]
    sha256rnds2 xmm2, xmm1, xmm0
    movdqa      xmm7, xmm3
    palignr     xmm7, xmm6, 4
    paddd       xmm4, xmm7
    sha256msg2  xmm4, xmm3
    pshufd      xmm0, xmm0, $0E
    sha256rnds2 xmm1, xmm2, xmm0
    sha256msg1  xmm6, xmm3
    // rounds 20..23
    movdqa      xmm0, xmm4
    paddd       xmm0, [r9 + 96]
    sha256rnds2 xmm2, xmm1, xmm0
    movdqa      xmm7, xmm4
    palignr     xmm7, xmm3, 4
    paddd       xmm5, xmm7
    sha256msg2  xmm5, xmm4
    pshufd      xmm0, xmm0, $0E
    sha256rnds2 xmm1, xmm2, xmm0
    sha256msg1  xmm3, xmm4
    // rounds 24..27
    movdqa      xmm0, xmm5
    paddd       xmm0, [r9 + 112]
    sha256rnds2 xmm2, xmm1, xmm0
    movdqa      xmm7, xmm5
    palignr     xmm7, xmm4, 4
    paddd       xmm6, xmm7
    sha256msg2  xmm6, xmm5
    pshufd      xmm0, xmm0, $0E
    sha256rnds2 xmm1, xmm2, xmm0
    sha256msg1  xmm4, xmm5
    // rounds 28..31
    movdqa      xmm0, xmm6
    paddd       xmm0, [r9 + 128]
    sha256rnds2 xmm2, xmm1, xmm0
    movdqa      xmm7, xmm6
    palignr     xmm7, xmm5, 4
    paddd       xmm3, xmm7
    sha256msg2  xmm3, xmm6
    pshufd      xmm0, xmm0, $0E
    sha256rnds2 xmm1, xmm2, xmm0
    sha256msg1  xmm5, xmm6
    // rounds 32..35
    movdqa      xmm0, xmm3
    paddd       xmm0, [r9 + 144]
    sha256rnds2 xmm2, xmm1, xmm0
    movdqa      xmm7, xmm3
    palignr     xmm7, xmm6, 4
    paddd       xmm4, xmm7
    sha256msg2  xmm4, xmm3
    pshufd      xmm0, xmm0, $0E
    sha256rnds2 xmm1, xmm2, xmm0
    sha256msg1  xmm6, xmm3
    // rounds 36..39
    movdqa      xmm0, xmm4
    paddd       xmm0, [r9 + 160]
    sha256rnds2 xmm2, xmm1, xmm0
    movdqa      xmm7, xmm4
    palignr     xmm7, xmm3, 4
    paddd       xmm5, xmm7
    sha256msg2  xmm5, xmm4
    pshufd      xmm0, xmm0, $0E
    sha256rnds2 xmm1, xmm2, xmm0
    sha256msg1  xmm3, xmm4
    // rounds 40..43
    movdqa      xmm0, xmm5
    paddd       xmm0, [r9 + 176]
    sha256rnds2 xmm2, xmm1, xmm0
    movdqa      xmm7, xmm5
    palignr     xmm7, xmm4, 4
    paddd       xmm6, xmm7
    sha256msg2  xmm6, xmm5
    pshufd      xmm0, xmm0, $0E
    sha256rnds2 xmm1, xmm2, xmm0
    sha256msg1  xmm4, xmm5
    // rounds 44..47
    movdqa      xmm0, xmm6
    paddd       xmm0, [r9 + 192]
    sha256rnds2 xmm2, xmm1, xmm0
    movdqa      xmm7, xmm6
