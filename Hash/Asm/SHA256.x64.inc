    add   eax, r12d
    add   eax, r15d
    rorx  r12d, r9d, 6
    rorx  r15d, r9d, 11
    xor   r12d, r15d
    rorx  r15d, r9d, 25
    xor   r12d, r15d
    add   eax, r12d
    add   r8d, eax
    rorx  r12d, ecx, 2
    rorx  r15d, ecx, 13
    xor   r12d, r15d
    rorx  r15d, ecx, 22
    xor   r12d, r15d
    add   eax, r12d
    mov   r15d, ecx
    xor   r15d, edx
    and   r13d, r15d
    xor   r13d, edx
