    movdqa      xmm0, xmm6
    paddd       xmm0, [esi + 256]
    sha256rnds2 xmm2, xmm1, xmm0
    pshufd      xmm0, xmm0, $0E
    sha256rnds2 xmm1, xmm2, xmm0
    movdqu      xmm3, [esp]
    paddd       xmm1, xmm3
    movdqu      xmm3, [esp + 16]
    paddd       xmm2, xmm3
    add   edx, 64
    cmp   edx, ecx
    jb    @loop
    pshufd      xmm1, xmm1, $1B
    pshufd      xmm2, xmm2, $B1
    movdqa      xmm7, xmm1
    pblendw     xmm1, xmm2, $F0
    palignr     xmm2, xmm7, 8
    movdqu      [eax], xmm1
    movdqu      [eax + 16], xmm2
    add   esp, 32
    pop   esi
@exit:
end;
