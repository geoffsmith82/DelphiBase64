    pshufb    xmm6, xmm7
    sha1nexte xmm2, xmm6
    movdqa    xmm1, xmm0
    sha1msg2  xmm3, xmm6
    sha1rnds4 xmm0, xmm2, 0
    sha1msg1  xmm5, xmm6
    pxor      xmm4, xmm6
    // rounds 16..19
    sha1nexte xmm1, xmm3
    movdqa    xmm2, xmm0
    sha1msg2  xmm4, xmm3
    sha1rnds4 xmm0, xmm1, 0
    sha1msg1  xmm6, xmm3
    pxor      xmm5, xmm3
    // rounds 20..23
