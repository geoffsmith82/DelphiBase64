    xor   r12d, r15d
    rorx  r15d, r11d, 25
    xor   r12d, r15d
    add   edx, r12d
    add   r10d, edx
    rorx  r12d, esi, 2
    rorx  r15d, esi, 13
    xor   r12d, r15d
    rorx  r15d, esi, 22
    xor   r12d, r15d
    add   edx, r12d
    mov   r15d, esi
